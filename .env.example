# Single environment file for the whole site (UI + API routes).
# Locally: copy to .env in the repository root (next.config.ts loads it from
# there via @next/env).
# On Vercel: add these variables in Project Settings → Environment Variables.

# ---------------------------------------------------------------------------
# Email configuration (contact form, /api/contact)
# Two providers are supported; both may be set — Resend is tried first and
# generic SMTP acts as a fallback. At least one is required in production.
#
# Provider 1 (recommended): Resend. Only the API key is needed; the sender
# address (SMTP_FROM) must belong to a domain verified in your Resend account.
RESEND_API_KEY=re_xxxxxxxxxxxx
#
# Provider 2 (fallback): generic SMTP — e.g. Spaceship/Spacemail
# (mail.spacemail.com:465) or Gmail (smtp.gmail.com:587 with an app password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Optional: force TLS on/off. Defaults to true when SMTP_PORT=465, false otherwise.
# SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# Sender address (defaults to CONTACT_EMAIL, then SMTP_USER). With Resend it
# must be on a domain verified in your Resend account — a verified subdomain
# works too (e.g. auth.barkosem.com); the recipient below can be any address.
SMTP_FROM=contact@auth.barkosem.com
# Recipient of contact form notifications (defaults to SMTP_USER)
CONTACT_EMAIL=contact@barkosem.com

# ---------------------------------------------------------------------------
# Optional overrides
# Directory where contact submissions are appended as JSONL (default: ./data
# locally, /tmp on Vercel where the filesystem is ephemeral).
# DATA_DIR=/path/to/data
# Contact form rate limit per hour per IP (default: 5)
# CONTACT_RATE_LIMIT_MAX=5
